# Copy to .env for local development. Never commit real values.
# Prisma's CLI reads .env (not .env.local), so keep DATABASE_URL here.

# --- Database ---------------------------------------------------------------
# Runtime connection. Matches docker-compose.yml defaults.
# In production this MUST be a POOLED url (see README → Deploying to Vercel).
DATABASE_URL="postgresql://frag:frag@localhost:55432/frag_avenue?schema=public"

# Unpooled connection, used only by `prisma migrate` — migrations cannot run
# through a transaction-mode pooler. Locally it is the same value as above.
# Both must be set: Prisma errors if a referenced variable is missing.
DIRECT_DATABASE_URL="postgresql://frag:frag@localhost:55432/frag_avenue?schema=public"

# --- Auth.js v5 -------------------------------------------------------------
# Generate: `openssl rand -base64 32`  (or `pnpm dlx auth secret`). Min 16 chars.
AUTH_SECRET=""
# Base URL of the app. Not required on Vercel (inferred from VERCEL_URL),
# but useful locally.
AUTH_URL="http://localhost:3000"

# Google sign-in (optional). Both or neither; without them the Google button is
# hidden. Create an OAuth client ID (type "Web application") in Google Cloud
# Console → APIs & Services → Credentials, with the redirect URI
#   http://localhost:3000/api/auth/callback/google
# (and https://<your-domain>/api/auth/callback/google for production).
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# --- Optional ---------------------------------------------------------------
# Creates the dev account (dev@frag.test) even when DATABASE_URL is not local.
# NEVER set this in production — the password is published in the README.
# SEED_DEV_USER="true"

# Auth attempt budgets. Leave unset in production; the defaults (10 sign-ins per
# 15 min, 5 sign-ups per hour) are the policy. playwright.config.ts raises them
# for the e2e suite, which drives real auth from a single IP.
# AUTH_SIGNIN_ATTEMPTS="10"
# AUTH_SIGNUP_ATTEMPTS="5"

# Weather provider for wear snapshots. Default: Open-Meteo (free tier is for
# non-commercial use; attribution is shown in the app). "static" returns fixed
# readings for tests/offline development — NEVER set it in production.
# WEATHER_PROVIDER="static"

# NEXT_PUBLIC_APP_NAME="Frag Avenue"
