# Copy to .env.local for local development. Never commit real values.

# Postgres — matches docker-compose.yml defaults
DATABASE_URL="postgresql://frag:frag@localhost:55432/frag_avenue?schema=public"

# Auth.js v5
# Generate: `openssl rand -base64 32`  (or `pnpm dlx auth secret`)
AUTH_SECRET=""
# Base URL of the app. Not required on Vercel, but useful for local + preview.
AUTH_URL="http://localhost:3000"

# Feature flags (optional)
# NEXT_PUBLIC_APP_NAME="Frag Avenue"
